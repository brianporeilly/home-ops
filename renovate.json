{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "labels": ["dependencies"],
  "flux": {
    "managerFilePatterns": [
      "/kubernetes/apps/.+\\.yaml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>.+?) depName=(?<depName>.+?)\\s+[A-Z_]+_VERSION: (?<currentValue>.+)"
      ],
      "datasourceTemplate": "{{{datasource}}}",
      "depNameTemplate": "{{{depName}}}"
    }
  ],
  "packageRules": [
    {
      "description": "Group app-template chart updates",
      "matchPackageNames": ["ghcr.io/bjw-s-labs/helm/app-template"],
      "groupName": "app-template",
      "automerge": false
    },
    {
      "description": "Group kube-prometheus-stack with its companion CRDs chart - they're versioned independently but released in lockstep against the same prometheus-operator appVersion",
      "matchPackageNames": [
        "ghcr.io/prometheus-community/charts/kube-prometheus-stack",
        "ghcr.io/prometheus-community/charts/prometheus-operator-crds"
      ],
      "groupName": "kube-prometheus-stack",
      "automerge": false
    },
    {
      "description": "Group mariadb-operator with its companion CRDs chart - previously merged as separate PRs (#58/#60, #87/#89)",
      "matchPackageNames": ["mariadb-operator", "mariadb-operator-crds"],
      "groupName": "mariadb-operator",
      "automerge": false
    },
    {
      "description": "Auto-merge patch updates for non-critical dependencies",
      "matchUpdateTypes": ["patch", "pin", "digest"],
      "matchManagers": ["flux"],
      "automerge": true
    }
  ]
}
